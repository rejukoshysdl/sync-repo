-        "Body HTML": "<section class=\"site-map\" id=\"sitemap-page\">\n<h1 class=\"heading\">Site Map</h1>\n<div class=\"site-content\">\n<h3>Discover</h3>\n<ul>\n<li><a href=\"/\">Meaningful Beauty Skincare</a></li>\n<li><a href=\"/pages/lp-core-ageproofhair\">Meaningful Beauty Haircare</a></li>\n<li><a href=\"/collections/shop\">Shop All</a></li>\n<li><a href=\"/pages/reviews-and-ratings\">Reviews &amp; Ratings</a></li>\n<li><a href=\"/pages/our-story\">Our Story</a></li>\n<li><a href=\"/pages/our-technology\">Our Technology</a></li>\n</ul>\n<h3>Deluxe Systems</h3>\n<ul>\n<li><a href=\"/products/7piece-deluxe-skincare-system\">7-Piece Deluxe Face &amp; Neck Skincare System</a></li>\n<li><a href=\"/products/4-piece-deluxe-age-proof-haircare-system-1\">4-Piece Deluxe Age-Proof Haircare System</a></li>\n</ul>\n<h3>Essentials Systems</h3>\n<ul>\n<li><a href=\"/products/5-piece-essentials-skincare-system-advanced-formula-1\">5-Piece Essentials Skincare System</a></li>\n<li><a href=\"/products/2-piece-essentials-haircare-system\">2-Piece Essentials Haircare System</a></li>\n</ul>\n<h3>Skincare Products</h3>\n<h4>Serums</h4>\n<ul>\n<li><a href=\"/products/youth-activating-melon-serum\">Youth Activating Melon Serum Advanced Formula</a></li>\n<li><a href=\"/products/creme-de-serum\">Cr\u00e8me de S\u00e9rum</a></li>\n<li><a href=\"/products/glowing-serum\">Glowing Serum</a></li>\n<li><a href=\"/products/firming-serum\">Firming Serum</a></li>\n<li><a href=\"/products/ultra-lifting-and-filling-treatment\">Ultra Lifting and Filling Treatment</a></li>\n</ul>\n<h4>Eye</h4>\n<ul>\n<li><a href=\"/products/youth-activating-smoothing-and-refreshing-eye-serum\">Youth Activating Smoothing and Refreshing Eye Serum</a></li>\n<li><a href=\"/products/eye-enhancing-serum\">Eye Enhancing Serum</a></li>\n<li><a href=\"/products/lifting-eye-creme\">Lifting Eye Cr\u00e8me \u2014 Advanced Formula</a></li>\n<li><a href=\"/products/revive-and-brighten-eye-masque\">Revive and Brighten Eye Masque</a></li>\n</ul>\n<h4>Masques &amp; Treatments</h4>\n<ul>\n<li><a href=\"/products/vitamin-c-bi-phase-brightening-oil\">Vitamin C Bi-Phase Brightening Oil with Activated-C Technology</a></li>\n<li><a href=\"/products/dark-spot-treatment\">Dark Spot Treatment</a></li>\n<li><a href=\"/products/wrinkle-smoothing-capsules\">Wrinkle Smoothing Capsules \u2014 Advanced Formula</a></li>\n<li><a href=\"/products/skin-brightening-treatment\">Skin Brightening Treatment</a></li>\n<li><a href=\"/products/skin-renewing-peel\">Skin Renewing Peel</a></li>\n<li><a href=\"/products/intensive-triple-exfoliating-treatment\">Intensive Triple Exfoliating Treatment</a></li>\n</ul>\n<h4>Moisturizers</h4>\n<ul>\n<li><a href=\"/products/vitamin-c-brightening-water-creme\">Vitamin C Brightening Water Cr\u00e8me with Activated Hydraspheres</a></li>\n<li><a href=\"/products/hydrating-and-soothing-facial-mist\">Hydrating and Soothing Facial Mist</a></li>\n<li><a href=\"/products/anti-aging-day-creme-1\">Anti-Aging Day Cr\u00e8me with Broad Spectrum SPF 30</a></li>\n<li><a href=\"/products/age-recovery-night-creme-with-retinol\">Age Recovery Night Cr\u00e8me with Retinol Advanced Formula</a></li>\n</ul>\n<h4>Cleansers &amp; Toners</h4>\n<ul>\n<li><a href=\"/products/pore-refining-toner\">Pore Refining Toner</a></li>\n<li><a href=\"/products/skin-softening-gentle-cleanser-1\">Skin Softening Gentle Cleanser</a></li>\n</ul>\n<h3>Body</h3>\n<ul>\n<li><a href=\"/products/firming-tightening-body-hydration-treatment\">Firming and Tightening Body Hydration Treatment</a></li>\n<li><a href=\"/products/skin-brightening-decollete-and-neck-treatment\">Skin Brightening D\u00e9collet\u00e9 and Neck Treatment SPF 15</a></li>\n</ul>\n<h3>Hair</h3>\n<ul>\n<li><a href=\"/products/strengthening-shampoo\">Strengthening Shampoo</a></li>\n<li><a href=\"/products/smooth-shiny-conditioner\">Smooth &amp; Shiny Conditioner</a></li>\n<li><a href=\"/products/restorative-scalp-treatment\">Restorative Scalp Treatment</a></li>\n<li><a href=\"/products/styling-and-protecting-spray\">Styling and Protecting Spray</a></li>\n<li><a href=\"/products/root-touch-up\">Root Touch Up</a></li>\n</ul>\n<h3>Helpful Links</h3>\n<ul>\n<li><a href=\"/pages/faq-customer-service\">Customer Service</a></li>\n<li><a href=\"/policies/privacy-policy\">Privacy Policy</a></li>\n<li><a href=\"/pages/accessibility\">Accessibility Statement</a></li>\n<li><a href=\"/pages/faq\">FAQs</a></li>\n<li><a href=\"/policies/terms-of-service\">Terms and Conditions</a></li>\n<li><a href=\"/pages/unauthorized-resellers\">Unauthorized Resellers</a></li>\n</ul>\n</div>\n</section>",
